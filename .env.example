# Phase 2+: your own Supabase project (Project Settings -> Database/API).
# POSTGRES_URL=              # Supavisor pooler, Transaction mode (port 6543) — app runtime
# POSTGRES_URL_NON_POOLING=  # Supavisor pooler, Session mode (port 5432) — drizzle-kit migrations
#                             # (the direct db.<ref>.supabase.co host is IPv6-only unless you've
#                             # bought the IPv4 add-on; use the pooler host for both, just a
#                             # different port/mode, or migrations will fail to connect)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY= # server-only, used by scripts/create-admin.ts
# ADMIN_EMAIL=               # the one account allowed into /admin
# CRON_SECRET=               # Vercel Cron sends this as a Bearer token
# LINK_HEALTH_WEBHOOK_URL=  # optional: Slack incoming webhook (or any JSON webhook) for
                            # link-health cron admin notifications (issue #41); when unset,
                            # the cron only logs its summary.
# SUBMISSIONS_WEBHOOK_URL=  # optional: webhook pinged when a student submits an offer
                            # (issue #35); falls back to LINK_HEALTH_WEBHOOK_URL.
# Weekly digest email (issue #38). RESEND_API_KEY is set by the Vercel
# Marketplace Resend integration (`vercel integration add resend/resend-email`).
# RESEND_API_KEY=
# DIGEST_FROM_EMAIL=         # verified sender, e.g. "StudentStack <digest@yourdomain>"
# DIGEST_SECRET=             # optional: signs unsubscribe links (defaults to CRON_SECRET)
# Ingestion sources (issue #83). APIFY_TOKEN enables the paid Apify actor
# sources (billed per run to your Apify account); GITHUB_TOKEN raises the
# GitHub API rate limit for list change detection.
# APIFY_TOKEN=
# GITHUB_TOKEN=
